<div data-visible="true" id="site-header"><nav class="navbar"><div class="container"><div class="nav-logo"><img alt="{{ site.logo_alt }}" src="{{ site.logo }}" style="height: 52px; width: auto; display: block;"/></div><div class="nav-links">{% for item in site.nav %}{% if item.children %}<details class="nav-drop"><summary class="nav-link">{{ item.label }}<svg aria-hidden="true" class="nav-drop-chev" fill="none" height="5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" viewbox="0 0 8 5" width="8"><path d="M1 1l3 3 3-3"></path></svg></summary><div class="nav-drop-menu">{% for child in item.children %}<a href="{{ child.url }}">{{ child.label }}</a>{% endfor %}</div></details>{% else %}<a class="nav-link" href="{{ item.url }}"{% if item.new_tab %} rel="noopener" target="_blank"{% endif %}>{{ item.label }}</a>{% endif %}{% endfor %}</div><div class="nav-right"><button class="nav-cta" data-href="{{ site.cta_url }}">{{ site.cta_label }}</button></div></div></nav></div>