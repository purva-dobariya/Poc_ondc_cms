<footer><div class="container"><div class="footer-inner"><div class="footer-brand"><div style="margin-bottom: 18px;"><img alt="{{ site.logo_alt }}" src="{{ site.logo }}" style="height: 42px; width: auto; display: block;"/></div><p>{{ site.footer.blurb }}</p></div>{% for column in site.footer.columns %}<div><div class="footer-col-head">{{ column.heading }}</div>{% for link in column.links %}<a class="footer-link" href="{{ link.url }}"{% if link.new_tab %} rel="noopener" target="_blank"{% endif %}>{{ link.label }}</a>{% endfor %}</div>{% endfor %}</div><div class="footer-bottom"><span class="footer-copy">{{ site.footer.copyright }}</span><div class="footer-social">{% for link in site.footer.social %}<a aria-label="{{ link.label }}" class="footer-social-link" href="{{ link.url }}" rel="noopener noreferrer" target="_blank">{% include "partials/social-icon.njk" %}</a>{% endfor %}</div></div></div></footer>