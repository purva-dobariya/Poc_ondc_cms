<footer{% if f.background_image %} style="--footer-image:url({{ f.background_image }})"{% endif %}><div class="container"><div class="footer-inner"><div class="footer-brand"><div style="margin-bottom: 18px;"><img alt="{{ f.logo_alt }}" src="{{ f.logo }}" style="height: 42px; width: auto; display: block;"/></div><p>{{ f.blurb }}</p></div>{% for column in f.link_columns %}<div><div class="footer-col-head">{{ column.heading }}</div>{% for link in column.links %}<a class="footer-link" href="{{ link.url }}"{% if link.new_tab %} rel="noopener" target="_blank"{% endif %}>{{ link.label }}</a>{% endfor %}</div>{% endfor %}</div><div class="footer-bottom"><span class="footer-copy">{{ f.copyright }}</span><div class="footer-social">{% for link in f.social %}<a aria-label="{{ link.label }}" class="footer-social-link" href="{{ link.url }}" rel="noopener noreferrer" target="_blank">{% include "partials/social-icon" %}</a>{% endfor %}</div></div></div></footer>