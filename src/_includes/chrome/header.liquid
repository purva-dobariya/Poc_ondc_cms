{%- assign home_url = site.home_url | default: "/home.html" -%}
<div data-visible="true" id="site-header">
  <nav class="navbar">
    <div class="container">
      <a class="nav-logo" href="{{ home_url }}#site-top"><img
          alt="{{ site.logo_alt }}"
          src="{{ site.logo }}"
          style="height: 52px; width: auto; display: block;"/></a>
      <div class="nav-links">
        {% for item in site.nav %}{% if item.children %}{%- comment -%}A drop-down is "active" when the page we are on is one of its children — the same rule the plain links use one branch down, just applied to the whole group.{%- endcomment -%}{% assign drop_active = "" %}{% for child in item.children %}{% if child.url == page.url %}{% assign drop_active = " active" %}{% endif %}{% endfor %}<details class="nav-drop"><summary class="nav-link{{ drop_active }}">{{ item.label }}<svg
                  aria-hidden="true"
                  class="nav-drop-chev"
                  fill="none"
                  height="5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.4"
                  viewbox="0 0 8 5"
                  width="8"><path d="M1 1l3 3 3-3"></path></svg></summary><div class="nav-drop-menu">{% for child in item.children %}<a href="{{ child.url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.label }}</a>{% endfor %}</div></details>{% else %}{% assign first_char = item.url | slice: 0 %}{% if first_char == "#" and page.url != home_url %}{% assign href = home_url | append: item.url %}{% else %}{% assign href = item.url %}{% endif %}<a
              class="nav-link{% if item.url == page.url %} active{% endif %}"
              href="{{ href }}"{% if item.new_tab %} rel="noopener"
              target="_blank"{% endif %}>{{ item.label }}</a>{% endif %}{% endfor %}
      </div>
      <div class="nav-right">
        <button class="nav-cta" onclick="window.open('{{ site.cta_url }}', '_blank', 'noopener')">{{ site.cta_label }}</button>
      </div>
    </div>
  </nav>
</div>
