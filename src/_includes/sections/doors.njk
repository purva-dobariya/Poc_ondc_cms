<section class="infra" id="{{ section.anchor_id | default("find-your-place") }}" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="container"><div class="section-header hv-rv"><h2 data-editable="text" data-prop="title">{{ section.title }}</h2><p data-editable="text" data-prop="intro">{{ section.intro }}</p></div><div class="doors-wrap"><button aria-label="Previous" class="doors-arrow prev" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 20 20" width="16"><path d="M13 4l-6 6 6 6"></path></svg></button><button aria-label="Next" class="doors-arrow next" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 20 20" width="16"><path d="M7 4l6 6-6 6"></path></svg></button><div class="doors-track" data-editable="array" data-prop="cards" data-id-key="heading" data-component-key="heading">{% for card in section.cards %}<div class="door-card hv-rv" style="transition-delay: {{ loop.index0 * 90 }}ms;" data-editable="array-item" data-id="{{ card.heading }}" data-component="{{ card.heading }}"><div class="door-media"><div class="cms-img"><img alt="{{ card.heading }}" loading="lazy" src="{{ card.image }}" data-editable="image" data-prop-src="image"/></div><div class="door-media-tag" data-editable="text" data-prop="tag">{{ card.tag }}</div></div><div class="door-body"><div class="infra-name" data-editable="text" data-prop="heading">{{ card.heading }}</div><div class="infra-desc" data-editable="text" data-prop="lead">{{ card.lead }}</div><ul class="infra-bullets">{% for bullet in card.bullets %}<li>{{ bullet.text | safe }}</li>{% endfor %}</ul><a class="btn btn-primary" href="{{ card.cta_url }}"{% if card.new_tab %} rel="noopener" target="_blank"{% endif %} style="margin-top: auto; align-self: flex-start;" data-editable="text" data-prop="cta_label">{{ card.cta_label }}</a></div></div>{% endfor %}</div></div><div class="doors-progress"><div class="doors-progress-bar"></div></div></div></section>