<section class="block block-text block--{{ section.background | default: "light" }}"><div class="container"><div class="block-inner{% if section.full_width %} is-wide{% endif %}">{% if section.eyebrow %}<div class="block-eyebrow">{{ section.eyebrow }}</div>{% endif %}{% if section.heading %}<h2 class="block-h2">{{ section.heading }}</h2>{% endif %}<div class="block-body">{{ section.body }}</div>{% if section.buttons %}<div class="block-actions">{% for button in section.buttons %}<a class="btn {% if button.style == "secondary" %}btn-light{% else %}btn-primary{% endif %}" href="{{ button.url }}">{{ button.label }}</a>{% endfor %}</div>{% endif %}</div></div></section>