<section class="block block-media block--{{ section.background | default: "light" }}"><div class="container"><div class="block-inner{% if section.full_width %} is-wide{% endif %}">{% if section.heading %}<h2 class="block-h2">{{ section.heading }}</h2>{% endif %}<figure class="block-figure">{% assign media = section.media %}{% include "partials/media" %}{% if section.caption %}<figcaption class="block-caption">{{ section.caption }}</figcaption>{% endif %}</figure></div></div></section>