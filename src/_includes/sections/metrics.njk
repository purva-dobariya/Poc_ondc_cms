<section class="metrics-bar" id="{{ section.anchor_id | default("financial") }}" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="container"><div class="metrics-header hv-rv"><h2 class="metrics-h2" data-editable="text" data-prop="title">{{ section.title }}</h2></div><div class="metrics-row" data-editable="array" data-prop="items" data-id-key="value" data-component-key="value">{% for item in section.items %}{% if not loop.first %}<div class="metric-sep"></div>{% endif %}<div class="metric hv-rv" style="transition-delay: {{ loop.index0 * 90 }}ms;" data-editable="array-item" data-id="{{ item.value }}" data-component="{{ item.value }}"><span aria-hidden="true" class="metric-fill"></span><div class="metric-num" data-editable="text" data-prop="value">{{ item.value }}</div><div class="metric-label">{{ item.label | nl2br | safe }}</div></div>{% endfor %}</div>{% set metric_count = section.items | length %}<p class="metrics-tagline hv-rv" style="transition-delay: {{ metric_count * 90 }}ms;" data-editable="text" data-prop="tagline">{{ section.tagline }}</p></div></section>