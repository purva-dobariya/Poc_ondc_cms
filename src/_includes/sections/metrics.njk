<section class="metrics-bar" id="{{ section.anchor_id | default("financial") }}"><div class="container"><div class="metrics-header hv-rv"><h2 class="metrics-h2">{{ section.title }}</h2></div><div class="metrics-row">{% for item in section.items %}{% if not loop.first %}<div class="metric-sep"></div>{% endif %}<div class="metric hv-rv" style="transition-delay: {{ loop.index0 * 90 }}ms;"><span aria-hidden="true" class="metric-fill"></span><div class="metric-num">{{ item.value }}</div><div class="metric-label">{{ item.label | nl2br | safe }}</div></div>{% endfor %}</div>{% set metric_count = section.items | length %}<p class="metrics-tagline hv-rv" style="transition-delay: {{ metric_count * 90 }}ms;">{{ section.tagline }}</p></div></section>