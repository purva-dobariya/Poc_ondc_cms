<section class="block block-media block--{{ section.background | default("light") }}" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="container"><div class="block-inner{% if section.full_width %} is-wide{% endif %}">{% if section.heading %}<h2 class="block-h2" data-editable="text" data-prop="heading">{{ section.heading }}</h2>{% endif %}<figure class="block-figure">{% set media = section.media %}{% include "partials/media.njk" %}{% if section.caption %}<figcaption class="block-caption" data-editable="text" data-prop="caption">{{ section.caption }}</figcaption>{% endif %}</figure></div></div></section>