<section class="block block-cards block--{{ section.background | default("light") }}" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="container">{% if section.heading %}<div class="section-header hv-rv"><h2 data-editable="text" data-prop="heading">{{ section.heading }}</h2>{% if section.intro %}<p data-editable="text" data-prop="intro">{{ section.intro }}</p>{% endif %}</div>{% endif %}<div class="block-grid cols-{{ section.columns | default(3) }}" data-editable="array" data-prop="cards" data-id-key="title" data-component-key="title">{% for card in section.cards %}<article class="block-card hv-rv" style="transition-delay: {{ loop.index0 * 90 }}ms;" data-editable="array-item" data-id="{{ card.title }}" data-component="{{ card.title }}">{% if card.media %}<div class="block-card-media">{% set media = card.media %}{% include "partials/media.njk" %}</div>{% endif %}<div class="block-card-body"><h3 class="block-card-title" data-editable="text" data-prop="title">{{ card.title }}</h3><div class="block-card-text" data-editable="text" data-type="block" data-prop="text">{{ card.text | safe }}</div>{% if card.link_label %}<a class="block-card-link" href="{{ card.link_url }}" data-editable="text" data-prop="link_label">{{ card.link_label }}</a>{% endif %}</div></article>{% endfor %}</div></div></section>