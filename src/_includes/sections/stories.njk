<section class="testimonials" id="{{ section.anchor_id | default("stories") }}" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="container"><div class="section-header hv-rv"><h2 data-editable="text" data-prop="title">{{ section.title }}</h2><p data-editable="text" data-prop="intro">{{ section.intro }}</p></div><div aria-hidden="true" class="net-wire"></div><div class="net-grid" data-editable="array" data-prop="items" data-id-key="name" data-component-key="name">{% for story in section.items %}<a aria-label="{{ story.name }}, {{ story.role }}: {{ story.quote }}" class="net-card hv-rv" href="{{ story.post_link }}" rel="noopener noreferrer" style="transition-delay: {{ 120 + loop.index0 * 110 }}ms;" target="_blank" data-editable="array-item" data-id="{{ story.name }}" data-component="{{ story.name }}"><span aria-hidden="true" class="net-node"></span><div class="net-poster"><img alt="{{ story.name }}, {{ story.role }}" loading="lazy" src="{{ story.poster }}" data-editable="image" data-prop-src="poster"/></div><div aria-hidden="true" class="net-foot"><span class="net-tag">{{ story.badge }}</span><span class="net-open"><svg aria-hidden="true" fill="currentColor" viewbox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg> View post</span></div></a>{% endfor %}</div></div></section>