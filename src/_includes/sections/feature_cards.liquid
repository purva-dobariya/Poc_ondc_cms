<section class="block block-cards block--{{ section.background | default: "light" }}"><div class="container">{% if section.heading %}<div class="section-header hv-rv"><h2>{{ section.heading }}</h2>{% if section.intro %}<p>{{ section.intro }}</p>{% endif %}</div>{% endif %}<div class="block-grid cols-{{ section.columns | default: 3 }}">{% for card in section.cards %}<article class="block-card hv-rv" style="transition-delay: {{ forloop.index0 | times: 90 }}ms;">{% if card.media %}<div class="block-card-media">{% assign media = card.media %}{% include "partials/media" %}</div>{% endif %}<div class="block-card-body"><h3 class="block-card-title">{{ card.title }}</h3><div class="block-card-text">{{ card.text }}</div>{% if card.link_label %}<a class="block-card-link" href="{{ card.link_url }}">{{ card.link_label }}</a>{% endif %}</div></article>{% endfor %}</div></div></section>