<section class="block block-cta block--{{ section.background | default: "dark" }}"><div class="container"><div class="block-cta-inner"><div class="block-cta-copy"><h2 class="block-h2">{{ section.heading }}</h2>{% if section.subtext %}<p class="block-cta-text">{{ section.subtext }}</p>{% endif %}</div>{% if section.buttons %}<div class="block-actions">{% for button in section.buttons %}<a class="btn {% if button.style == "secondary" %}btn-light{% else %}btn-primary{% endif %}" href="{{ button.url }}"{% if button.new_tab %} rel="noopener" target="_blank"{% endif %}>{{ button.label }}</a>{% endfor %}</div>{% endif %}</div></div></section>