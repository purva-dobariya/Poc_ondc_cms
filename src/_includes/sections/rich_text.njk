<section class="block block-text block--{{ section.background | default("light") }}" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="container"><div class="block-inner{% if section.full_width %} is-wide{% endif %}">{% if section.eyebrow %}<div class="block-eyebrow" data-editable="text" data-prop="eyebrow">{{ section.eyebrow }}</div>{% endif %}{% if section.heading %}<h2 class="block-h2" data-editable="text" data-prop="heading">{{ section.heading }}</h2>{% endif %}<div class="block-body" data-editable="text" data-type="block" data-prop="body">{{ section.body | safe }}</div>{% if section.buttons %}<div class="block-actions">{% for button in section.buttons %}<a class="btn {% if button.style == "secondary" %}btn-light{% else %}btn-primary{% endif %}" href="{{ button.url }}">{{ button.label }}</a>{% endfor %}</div>{% endif %}</div></div></section>