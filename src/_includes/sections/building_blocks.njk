<section class="dpi" id="{{ section.anchor_id | default("infrastructure") }}" style="--dpi-n: {{ section.cards | length }};" data-editable="array-item" data-id="{{ section._type }}" data-component="{{ section._type }}"><div class="dpi-bg"></div><div class="dpi-stage"><div class="container"><div class="dpi-header"><h2 class="dpi-h2" data-editable="text" data-prop="title">{{ section.title }}</h2><p class="dpi-sub" data-editable="text" data-prop="intro">{{ section.intro }}</p></div></div><div class="dpi-deck" data-editable="array" data-prop="cards" data-id-key="name" data-component-key="name">{% for card in section.cards %}<article class="dpi-card" data-editable="array-item" data-id="{{ card.name }}" data-component="{{ card.name }}"><span aria-hidden="true" class="dpi-card-wash"></span><div class="dpi-card-body"><span aria-hidden="true" class="dpi-card-ghost">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span><div class="dpi-eyebrow"><span>{{ card.eyebrow | default("Building block") }}</span>{% if card.coming_soon %}<span class="dpi-soon">Coming soon</span>{% endif %}</div><h3 class="dpi-name" data-editable="text" data-prop="name">{{ card.name }}</h3><div class="dpi-tagline" data-editable="text" data-prop="tagline">{{ card.tagline }}</div><p class="dpi-desc" data-editable="text" data-prop="details">{{ card.details }}</p></div><div class="dpi-media" style="--dpi-img:url({{ card.image }});"><div class="cms-img"><img alt="{{ card.image_tag }}" loading="lazy" src="{{ card.image }}" data-editable="image" data-prop-src="image"/></div><div class="dpi-media-tag" data-editable="text" data-prop="image_tag">{{ card.image_tag }}</div></div></article>{% endfor %}</div><div class="dpi-controls"><button aria-label="Previous" class="dpi-arrow prev"><svg fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 20 20" width="18"><path d="M13 4l-6 6 6 6"></path></svg></button><div class="dpi-dots">{% for card in section.cards %}<button aria-label="Go to block {{ loop.index }}" class="dpi-dot"></button>{% endfor %}</div><button aria-label="Next" class="dpi-arrow next"><svg fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 20 20" width="18"><path d="M7 4l6 6-6 6"></path></svg></button></div></div></section>