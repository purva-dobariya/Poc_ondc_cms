{% if variant == "role" %}<section class="bk-role-close"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Closing" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>
      <div class="bk-rv">
        <h2 class="bk-h2"{% if heading_id %} id="{{ heading_id }}"{% endif %}>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
{% if body %}        <p>{{ body }}</p>
{% endif %}{% for button in buttons %}{% if button.action == "signup" %}        <button type="button" class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}" onclick="ONDCSignup.open()">{{ button.label }}</button>
{% else %}        <a class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}" href="{{ button.url }}"{% if button.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ button.label }}</a>
{% endif %}{% endfor %}      </div>
    </section>
{% else %}<section class="bk-about-close" data-screen-label="{{ screen_label | default: "Closing" }}">
      <h2 class="bk-h2 bk-rv">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
{% if buttons.size > 0 %}      <div class="bk-hero-actions bk-rv bk-rv-d1">
{% for button in buttons %}{% if button.action == "signup" %}        <button type="button" class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}" onclick="ONDCSignup.open()">{{ button.label }}</button>
{% else %}        <a class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}" href="{{ button.url }}"{% if button.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ button.label }}</a>
{% endif %}{% endfor %}      </div>
{% endif %}    </section>
{% endif %}