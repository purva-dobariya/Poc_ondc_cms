{%- assign hid = heading_id | default: "page-title" -%}
<section class="bk-contact-head" aria-labelledby="{{ hid }}" data-screen-label="{{ screen_label | default: "Page title" }}">
      <h1 id="{{ hid }}" data-bk-intro>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h1>
{% if intro %}      <p data-bk-intro>{{ intro }}</p>
{% endif %}    </section>
