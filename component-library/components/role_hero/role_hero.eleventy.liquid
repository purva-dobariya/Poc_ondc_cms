<section class="bk-role-hero"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Hero" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>
      <div>
        <h1{% if heading_id %} id="{{ heading_id }}"{% endif %} data-bk-intro>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h1>
{% if copy %}        <p class="bk-role-hero-copy" data-bk-intro>{{ copy }}</p>
{% endif %}{% if buttons.size > 0 %}        <div class="bk-role-hero-actions" data-bk-intro>
{% for button in buttons %}{% if button.action == "signup" %}          <button type="button" class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}" onclick="ONDCSignup.open()">{{ button.label }}</button>
{% else %}          <a class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}" href="{{ button.url }}"{% if button.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ button.label }}</a>
{% endif %}{% endfor %}        </div>
{% endif %}      </div>
{% if tally.show %}      <div class="bk-role-tally"{% if tally.aria_label %} aria-label="{{ tally.aria_label }}"{% endif %}>
        <strong class="bk-role-tally-value"{% if tally.value_id %} id="{{ tally.value_id }}"{% endif %}>{{ tally.placeholder | default: "—" }}</strong>
        <span class="bk-role-tally-label">{{ tally.label }}</span>
{% if tally.source_note %}        <span class="bk-role-tally-source">{{ tally.source_note }}</span>
{% endif %}      </div>
{% endif %}    </section>
