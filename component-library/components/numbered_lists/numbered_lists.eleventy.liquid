{% if variant == "culture" %}<section class="bk-culture"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Our people" }}">
    <div class="bk-culture-lead">
      {% if eyebrow %}
        <div class="bk-eyebrow bk-rv">{{ eyebrow }}</div>
      {% endif %}
      <h2 class="bk-h2 bk-rv">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>
        {% endif %}</h2>
      {% if lead %}
        <p data-bk-scrub>{{ lead }}</p>
      {% endif %}
    </div>
    <div class="bk-barriers bk-rv bk-rv-d1">
      {% assign n = 0 %}
      {% for group in groups %}
        {% for item in group.items %}
          {% assign n = n | plus: 1 %}
          <div class="bk-barrier">
            <span class="bk-barrier-n">{% if n < 10 %}0{% endif %}{{ n }}</span>
            <span class="bk-barrier-t">{{ item.text }}</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </section>
{% else %}<section class="bk-panel bk-matters"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Why it matters" }}">
    <div class="bk-matters-grid">
      <div class="bk-reality-lead bk-rv">
        {% if eyebrow %}
          <div class="bk-eyebrow">{{ eyebrow }}</div>
        {% endif %}
        <h2 class="bk-h2">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>
          {% endif %}</h2>
        {% if lead %}
          <p>{{ lead }}</p>
        {% endif %}
      </div>
      <div>
        {% for group in groups %}
          <div class="bk-eyebrow{% unless forloop.first %} bk-matters-gap{% endunless %} bk-rv">{{ group.heading }}</div>
          {% if group.intro %}
            <p class="bk-matters-sub bk-rv">{{ group.intro }}</p>
          {% endif %}
          <div class="bk-barriers bk-rv bk-rv-d1">
            {% for item in group.items %}
              <div class="bk-barrier">
                <span class="bk-barrier-n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <p class="bk-barrier-t">{{ item.text }}</p>
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}