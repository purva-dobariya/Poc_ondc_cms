<footer{% if background_image %} style="--footer-image:url({{ background_image }})"{% endif %}><div class="container"><div class="footer-inner"><div class="footer-brand"><div style="margin-bottom: 18px;"><img alt="{{ logo_alt }}" src="{{ logo }}" style="height: 42px; width: auto; display: block;"/></div><p>{{ blurb }}</p></div>{% for column in link_columns %}<div><div class="footer-col-head">{{ column.heading }}</div>{% for link in column.links %}<a class="footer-link" href="{{ link.url }}"{% if link.new_tab %} rel="noopener" target="_blank"{% endif %}>{{ link.label }}</a>{% endfor %}</div>{% endfor %}</div><div class="footer-bottom"><span class="footer-copy">{{ copyright }}</span><div class="footer-social">{% for link in social %}<a aria-label="{{ link.label }}" class="footer-social-link" href="{{ link.url }}" rel="noopener noreferrer" target="_blank">{% bookshop_include "social-icon" platform: link.platform %}</a>{% endfor %}</div></div></div></footer>